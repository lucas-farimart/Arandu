    {$dbNames(realName1)::[format {tb_arandu.top.core_u.core_q[7:0]}]} {-color #b0a6f0 -namecolor #b0a6f0}
    {$dbNames(realName1)::[format {tb_arandu.top.core_u.core_actv_mux[7:0]}]} {-color #b0a6f0 -namecolor #b0a6f0}
    {$dbNames(realName1)::[format {tb_arandu.top.core_u.core_acc[31:0]}]} {-color #b0a6f0 -namecolor #b0a6f0}
}] childcmds {
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}
